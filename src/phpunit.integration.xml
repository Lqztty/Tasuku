<?xml version="1.0" encoding="UTF-8"?>
<!--
    MySQL を使う結合テスト用の設定（tests/Integration だけを実行する）。
    ロック・トランザクション・外部キーなど、SQLite では確かめられない動きを検証する。
    DB は compose.yaml の db サービスが初回起動時に作る tasuku_testing を使う。

    実行方法は CLAUDE.md の「コマンド」を参照（XML のコメントにはハイフン2つを書けないため）。
-->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Integration">
            <directory>tests/Integration</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing" force="true"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="ALLOWED_EMAIL_DOMAINS" value="example.com,example.org,example.net"/>
        <env name="DB_CONNECTION" value="mysql" force="true"/>
        <env name="DB_HOST" value="db" force="true"/>
        <env name="DB_PORT" value="3306" force="true"/>
        <env name="DB_DATABASE" value="tasuku_testing" force="true"/>
        <env name="DB_USERNAME" value="tasuku" force="true"/>
        <env name="DB_PASSWORD" value="secret" force="true"/>
        <env name="DB_URL" value="" force="true"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
